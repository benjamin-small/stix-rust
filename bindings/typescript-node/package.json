{
  "name": "@stix-rust/node",
  "version": "0.1.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "napi": {
    "name": "stix-node",
    "triples": {
      "defaults": false,
      "additional": [
        "x86_64-unknown-linux-gnu",
        "aarch64-apple-darwin",
        "x86_64-pc-windows-msvc"
      ]
    }
  },
  "files": [
    "dist",
    "binding.js",
    "binding.d.ts"
  ],
  "scripts": {
    "build:native": "napi build --platform --release --js binding.js --dts binding.d.ts",
    "build:ts": "tsc",
    "build": "npm run build:native && npm run build:ts",
    "test": "napi build --platform --js binding.js --dts binding.d.ts && tsc && vitest run"
  },
  "devDependencies": {
    "@napi-rs/cli": "^2.18.0",
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  },
  "optionalDependencies": {
    "@stix-rust/node-linux-x64-gnu": "0.1.1",
    "@stix-rust/node-darwin-arm64": "0.1.1",
    "@stix-rust/node-win32-x64-msvc": "0.1.1"
  }
}
