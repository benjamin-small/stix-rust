{
  "name": "@stix-rust/wasm",
  "version": "0.1.1",
  "main": "dist/index.js",
  "types": "dist/index.d.ts",
  "files": [
    "dist",
    "pkg"
  ],
  "scripts": {
    "build:wasm": "wasm-pack build --target nodejs --out-dir pkg && node -e \"require('fs').rmSync('pkg/.gitignore',{force:true})\"",
    "build:web": "wasm-pack build --target web --out-dir pkg-web",
    "build:playground": "npm run build:web && node scripts/build-playground.mjs",
    "build": "npm run build:wasm && tsc",
    "test": "npm run build:wasm && tsc && vitest run"
  },
  "devDependencies": {
    "typescript": "^5.4.0",
    "vitest": "^4.1.11"
  },
  "publishConfig": {
    "access": "public"
  }
}
